# --- Django -----------------------------------------------------------------
# Genera una chiave con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambiami-con-una-chiave-casuale
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Origini fidate per il CSRF (di norma non serve su Railway: viene dedotta da ALLOWED_HOSTS)
# CSRF_TRUSTED_ORIGINS=https://welfare.example.com

# --- Database (PostgreSQL) --------------------------------------------------
DATABASE_URL=postgres://welfare:welfare@localhost:5432/welfare
# Su Railway usa il riferimento al servizio Postgres: ${{Postgres.DATABASE_URL}}
# DB_SSL_REQUIRE=True

# --- Cloudflare R2 (bucket PRIVATO, API S3-compatible) ----------------------
# Se queste variabili non sono valorizzate, gli allegati vengono salvati
# su filesystem locale (solo per lo sviluppo).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_REGION_NAME=auto
# R2_URL_EXPIRE_SECONDS=300

# --- Allegati ---------------------------------------------------------------
# ATTACHMENT_MAX_SIZE_MB=10
# ATTACHMENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,doc,docx,xls,xlsx,odt,ods,txt,csv

# --- Notifiche email --------------------------------------------------------
# Unico destinatario delle notifiche amministrative (nuove richieste e
# riepilogo giornaliero). Nessuna email viene inviata ai dipendenti.
WELFARE_NOTIFICATION_EMAIL=agevolazioni@studiobirardi.it
# URL pubblica dell'app, usata per i link dentro le email.
# Su Railway viene dedotta da RAILWAY_PUBLIC_DOMAIN se non impostata.
# SITE_BASE_URL=https://welfare.example.com

# Server SMTP. Finché EMAIL_HOST è vuoto le notifiche restano inerti
# (in sviluppo, con DEBUG=True, vengono stampate a console).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=welfare@studiobirardi.it
# EMAIL_SUBJECT_PREFIX="[Welfare] "

# --- Varie ------------------------------------------------------------------
# TIME_ZONE=Europe/Rome
# LOG_LEVEL=INFO
# SECURE_SSL_REDIRECT=True
